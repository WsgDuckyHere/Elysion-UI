-- // Load the library
-- (If you use an executor, you would normally do: loadstring(game:HttpGet("YOUR_GITHUB_RAW_LINK_HERE"))())
-- For testing locally, assuming the library file is in the same folder:
local library = loadstring(readfile("library.lua"))() 

-- // Create the main window
local window = library:new({
	name = "Elysion - Free",
	color = Color3.fromRGB(255, 175, 0), -- A nice golden accent color
	font = "RobotoMono",
	textsize = 12
})

-- // Register a callback for when the menu is closed/unloaded
window:OnUnload(function()
	print("[Elysion] Menu unloaded cleanly.")
end)

-- ============================================================
-- TAB 1: "Main" (This will open automatically)
-- ============================================================
local mainPage = window:page({ 
	name = "Main", 
	pointer = "main" 
})

-- ============================================================
-- LEFT SIDE SECTIONS (Main Tab)
-- ============================================================
local combatSection = mainPage:section({
	name = "Combat",
	side = "left",
	size = 220,
	pointer = "combat"
})

combatSection:toggle({
	name = "Aimbot",
	def = false,
	callback = function(state)
		print("Aimbot toggled:", state)
	end,
	pointer = "aimbot"
})

combatSection:toggle({
	name = "Silent Aim",
	def = true,
	callback = function(state)
		print("Silent Aim toggled:", state)
	end,
	pointer = "silentaim"
})

combatSection:slider({
	name = "FOV",
	def = 100,
	min = 10,
	max = 500,
	rounding = true,
	measurement = "px",
	callback = function(val)
		print("FOV updated:", val)
	end,
	pointer = "fov"
})

combatSection:dropdown({
	name = "Target Part",
	def = "Head",
	options = { "Head", "Torso", "Nearest", "Random" },
	callback = function(val)
		print("Target part:", val)
	end,
	pointer = "targetpart"
})

-- ============================================================
-- RIGHT SIDE SECTIONS (Main Tab)
-- ============================================================
local visualsSection = mainPage:section({
	name = "Visuals",
	side = "right",
	size = 220,
	pointer = "visuals"
})

visualsSection:toggle({
	name = "Player ESP",
	def = true,
	callback = function(state)
		print("ESP enabled:", state)
	end,
	pointer = "esp"
})

visualsSection:keybind({
	name = "Toggle ESP Key",
	def = Enum.KeyCode.E,
	callback = function(key)
		print("ESP Key changed to:", tostring(key))
	end,
	pointer = "espkey"
})

visualsSection:colorpicker({
	name = "ESP Color",
	def = Color3.fromRGB(255, 80, 80),
	callback = function(color)
		print("ESP Color updated:", tostring(color))
	end,
	pointer = "espcolor"
})

-- A button to demonstrate the pointer system (resetting the Aimbot FOV)
visualsSection:button({
	name = "Reset Combat Settings",
	callback = function()
		-- Use pointers to find and change the FOV slider instantly
		window.pointers.main.combat.fov:set(100)
		window.pointers.main.combat.aimbot:set(false)
		print("Combat settings reset!")
	end
})


-- ============================================================
-- TAB 2: "Settings" (Hidden until clicked)
-- ============================================================
local settingsPage = window:page({ 
	name = "Settings", 
	pointer = "settings" 
})

-- ============================================================
-- MULTISECTION (Inner Tabs) (Settings Tab)
-- ============================================================
local miscMulti = settingsPage:multisection({
	name = "Miscellaneous",
	side = "left",
	size = 300,
	pointer = "misc"
})

-- Inner Tab 1
local playerSub = miscMulti:section({ name = "Player", pointer = "player" })

playerSub:slider({
	name = "Walk Speed",
	def = 16,
	min = 16,
	max = 200,
	rounding = true,
	callback = function(val)
		print("WalkSpeed set to:", val)
	end,
	pointer = "walkspeed"
})

playerSub:toggle({
	name = "Infinite Jump",
	def = false,
	callback = function(state)
		print("Infinite Jump:", state)
	end,
	pointer = "infjump"
})

-- Inner Tab 2
local worldSub = miscMulti:section({ name = "World", pointer = "world" })

worldSub:toggle({
	name = "Fullbright",
	def = true,
	callback = function(state)
		print("Fullbright:", state)
	end,
	pointer = "fullbright"
})

worldSub:buttonbox({
	name = "Time of Day",
	def = "Day",
	options = { "Day", "Night", "Sunset" },
	callback = function(val)
		print("Time set to:", val)
	end,
	pointer = "timeofday"
})

-- ============================================================
-- RIGHT SIDE (Settings Tab)
-- ============================================================
local configSection = settingsPage:section({
	name = "Configs",
	side = "right",
	size = 300,
	pointer = "configs"
})

-- This requires the executor to support readfile/writefile/listfiles
configSection:configloader({ 
	folder = "Elysion_Configs/" 
})


-- ============================================================
-- EXTRAS (Watermark)
-- ============================================================
local wm = window:watermark()
wm:toggle(true)
wm:update({
	["Elysion"] = "v1.0.0",
	["Status"] = "Injected"
})
-- Move the watermark to the bottom right if desired
wm:updateside("bottomright")

print("[Elysion] Example UI loaded successfully!")
